{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build with Make",
            "type": "shell",
            "command": "make",
            "args": [
                "all" // Calls the 'all' target in your Makefile
            ],
            "options": {
                "cwd": "${workspaceFolder}" // Run 'make' from the root of your project folder
            },
            "group": {
                "kind": "build",
                "isDefault": true // This becomes the default action for Ctrl+Shift+B
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared", // Share the panel with other tasks
                "clear": true
            },
            // This matcher helps VS Code parse error messages generated by ca65/ld65 when make runs them
            "problemMatcher": [
                "$ca65",
                "$ld65"
            ]
        },
        {
            "label": "Run ROM (FCEUX)",
            "type": "shell",
            "command": "fceux",
            "args": [
                "bin/main.nes" // Assumes your Makefile puts the final NES file in the bin/ directory
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated" // Keeps the emulator output in its own terminal panel
            },
            "dependsOn": [
                "Build with Make" // Ensure the build is run first
            ]
        },
        {
            "label": "Build and Run (Make + FCEUX)",
            "dependsOn": [
                "Run ROM (FCEUX)" // Running "Run ROM (FCEUX)" triggers "Build with Make" first
            ],
            "group": {
                "kind": "test", // Use 'test' group so 'Build with Make' is still the 'build' default
                "isDefault": false
            },
            "problemMatcher": []
        }
    ]
}